# Copy to .env.local (which is gitignored) and fill in.
# Twilio -- outbound voice
TW_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TW_TOKEN=            # exactly 32 characters; a short paste 401s with code 20003
TW_FROM=+1866xxxxxxx # the number that places the call
TW_TO=+1xxxxxxxxxx   # the phone that receives it

# OpenAI -- triage, and the Realtime voice path
OPENAI_API_KEY=sk-xxxx
